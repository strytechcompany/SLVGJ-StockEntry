# ──────────────────────────────────────────────────────────────
# Stock Entry — environment variables
# Copy this file to `.env` and fill in real values.
# ──────────────────────────────────────────────────────────────

# Express API port (the renderer talks to http://localhost:<API_PORT>)
API_PORT=3001

# Shared SQLite database path. All 3 desktop apps (Stock Entry, Billing,
# Admin) must point to the SAME file so changes are reflected everywhere.
DB_PATH=C:/ProgramData/JewelrySuite/gold_system.db

# Gmail SMTP for owner-approval emails and monthly reports.
# Use a Gmail "App Password" — NOT your regular Gmail password.
# https://support.google.com/accounts/answer/185833
GMAIL_USER=your.business@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where approval codes and the monthly report are sent.
OWNER_EMAIL=owner@example.com

# Friendly name shown in the email "From" field.
EMAIL_FROM_NAME=Jewelry Stock Entry

# How long an approval code stays valid (minutes).
CODE_TTL_MINUTES=10

# How often to poll the shared DB for sale events from the Billing app (ms).
SALE_POLL_MS=3000

# Session token TTL (hours). Staff stays logged in this long after approval.
SESSION_TTL_HOURS=8

# Exact Windows printer name for the label printer (USB or Bluetooth).
# Open "Printers & scanners" in Windows settings to see the exact name.
# If empty, the OS default printer is used and the system print dialog
# is shown instead of silent printing.
LABEL_PRINTER_NAME=

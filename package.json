{
  "name": "stock-entry",
  "version": "1.0.0",
  "description": "Jewelry Stock Entry desktop app (Electron + React + Express + SQLite)",
  "main": "electron/main.js",
  "scripts": {
    "dev:renderer": "vite --config renderer/vite.config.js",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev": "concurrently -k -n RENDERER,ELECTRON -c magenta,cyan \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "vite build --config renderer/vite.config.js",
    "start": "electron ."
  },
  "keywords": ["jewelry", "inventory", "electron", "stock-entry"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bwip-js": "^4.8.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.15",
    "sqlite3": "^6.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "electron": "^41.1.0",
    "postcss": "^8.4.49",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^9.0.4"
  }
}
